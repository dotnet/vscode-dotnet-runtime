{
    "compilerOptions": {
		"module": "commonjs",
		"target": "es2022",
		"outDir": "dist",
		"lib": [
			"es2022"
		],
		"skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
		"rootDir": "src",
		"strict": true   /* enable all strict type-checking options */
	},
	"exclude": [
		"**/node_modules/**",
		"**/.vscode-test/**",
		"**/dist/**",
	]
}
